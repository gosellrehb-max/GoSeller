{
  "name": "goseller-backend",
  "version": "1.0.0",
  "description": "World's Best E-commerce Backend - GoSellr (NestJS)",
  "main": "dist/main.js",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:prod": "node dist/main",
    "dev": "nest start --watch",
    "seed:products": "node seed.js",
    "migrate:identity:dry": "node scripts/migrate-user-identity.js",
    "migrate:identity:apply": "node scripts/migrate-user-identity.js --apply",
    "migrate:identity:finalize": "node scripts/migrate-user-identity.js --apply --enforce-index"
  },
  "dependencies": {
    "@faker-js/faker": "^10.4.0",
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.1.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/mongoose": "^10.0.0",
    "@nestjs/passport": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "cloudinary": "^2.7.0",
    "compression": "^1.7.4",
    "dotenv": "^16.3.1",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "mongoose": "^8.0.3",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.10.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "redis": "^4.6.10",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.10.0",
    "@types/nodemailer": "^7.0.11",
    "@types/passport-jwt": "^4.0.1",
    "typescript": "^5.3.0"
  },
  "keywords": [
    "ecommerce",
    "backend",
    "api",
    "nestjs",
    "mongodb",
    "nodejs",
    "rest-api",
    "gosellr"
  ],
  "author": "EHB Team",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
