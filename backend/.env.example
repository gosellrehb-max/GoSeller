# =============================================
# GoSellr Backend – Environment configuration
# =============================================
# Copy to .env and set values. Never commit .env.
# Inventory matches src/config/configuration.ts and src/config/env.validation.ts

# ----- Server -----
NODE_ENV=development
PORT=5000
API_PREFIX=api

# ----- Database -----
# Required when NODE_ENV=production (no localhost default).
MONGODB_URI=mongodb://localhost:27017/gosellr
# Optional pool/timeouts:
# MONGODB_POOL_SIZE=10
# MONGODB_TIMEOUT_MS=5000
# MONGODB_SOCKET_TIMEOUT_MS=45000

# ----- JWT -----
# Required when NODE_ENV=production (no dev fallback secret).
JWT_SECRET=your-secret-key-min-32-chars-recommended
JWT_EXPIRES_IN=8h
# Optional; refresh signing defaults to JWT_SECRET if unset:
# JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d

# ----- App (optional) -----
# APP_NAME=GoSellr
# APP_VERSION=1.0.0

# ----- CORS -----
# Comma-separated origins or * (see Nest enableCors wiring in main.ts).
CORS_ORIGIN=*

# ----- Cloudinary (image upload) -----
# If unset, uploads that require Cloudinary will fail at request time.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# CLOUDINARY_FOLDER=goseller

# ----- SMTP (email) -----
# Required when NODE_ENV=production (signup verification + forgot password).
# In development, OTP flows still run but email may be skipped if SMTP is unset (see EmailService).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# SMTP_FROM=noreply@example.com
# SMTP_SECURE=false

# ----- Redis (optional) -----
# Product search cache: shared Redis when set; otherwise in-process memory cache only.
# REDIS_URL=redis://localhost:6379

# ----- Auth / IdP (reserved) -----
AUTH_SOURCE=local
IDP_ENABLED=false
# IDP_BASE_URL=https://idp.example.com
# IDP_CALLBACK_PATH=/api/auth/idp/callback

# ----- Auth / account approval & OTP -----
REQUIRE_ADMIN_APPROVAL=true
VERIFICATION_CODE_TTL_MINUTES=10
VERIFICATION_CODE_LENGTH=6

# ----- Products (marketplace) -----
DISABLE_PRODUCT_ADMIN_APPROVAL=true
HIDE_PRODUCT_CATALOG_FOR_SELLERS=true
PRODUCT_SEARCH_CACHE_TTL_SECONDS=45

# ----- Feature flags -----
ENABLE_FRANCHISE=false
